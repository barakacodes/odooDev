<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_forecourt_operations" model="ir.module.category">
        <field name="name">Forecourt Operations</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_forecourt_user" model="res.groups">
        <field name="name">Forecourt User</field>
        <field name="category_id" ref="module_forecourt_operations"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_forecourt_supervisor" model="res.groups">
        <field name="name">Forecourt Supervisor</field>
        <field name="category_id" ref="module_forecourt_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_forecourt_user'))]"/>
    </record>

    <record id="group_forecourt_manager" model="res.groups">
        <field name="name">Forecourt Manager</field>
        <field name="category_id" ref="module_forecourt_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_forecourt_supervisor'))]"/>
    </record>
</odoo>