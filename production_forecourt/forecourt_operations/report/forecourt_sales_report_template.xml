<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_forecourt_sales_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="data"    t-value="docs[0].get_report_values()"/>
                <t t-set="lines"   t-value="data['lines']"/>
                <t t-set="totals"  t-value="data['totals']"/>
                <t t-set="company" t-value="data['company']"/>
                <t t-set="wizard"  t-value="data['wizard']"/>

                <div class="page">
                    <div style="margin-bottom:6px; line-height:1.6;">
                        <div><strong style="font-size:13px;" t-esc="company.name"/></div>
                        <div t-esc="company.street or ''"/>
                        <div t-esc="company.city or ''"/>
                        <div>TPIN: <t t-esc="company.vat or ''"/></div>
                    </div>

                    <div style="margin-bottom:2px;"><strong style="font-size:13px;">Forecourt Sales Report</strong></div>
                    <div style="margin-bottom:10px; font-style:italic; font-weight:bold;">
                        <t t-esc="wizard.date_from"/> to <t t-esc="wizard.date_to"/>
                    </div>

                    <table style="width:100%; border-collapse:collapse; font-size:9px;">
                        <thead>
                            <tr style="background:#D9D9D9; font-weight:bold; text-align:center;">
                                <th style="border:1px solid #000; padding:3px; width:9%;">Date/Time</th>
                                <th style="border:1px solid #000; padding:3px; width:8%;">Ref</th>
                                <th style="border:1px solid #000; padding:3px; width:7%;">Shift</th>
                                <th style="border:1px solid #000; padding:3px; width:7%;">Type</th>
                                <th style="border:1px solid #000; padding:3px; width:16%;">Product</th>
                                <th style="border:1px solid #000; padding:3px; width:8%;">Pump</th>
                                <th style="border:1px solid #000; padding:3px; width:10%;">Cashier</th>
                                <th style="border:1px solid #000; padding:3px; width:9%;">Payment</th>
                                <th style="border:1px solid #000; padding:3px; width:7%;">Qty</th>
                                <th style="border:1px solid #000; padding:3px; width:9%;">Unit Price</th>
                                <th style="border:1px solid #000; padding:3px; width:10%;">Total (ZMW)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lines" t-as="line">
                                <tr>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <t t-esc="line['date'].strftime('%d-%b-%y %H:%M') if line['date'] else ''"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px;" t-esc="line['ref']"/>
                                    <td style="border:1px solid #000; padding:2px;" t-esc="line['shift']"/>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;" t-esc="line['product_type']"/>
                                    <td style="border:1px solid #000; padding:2px;" t-esc="line['product']"/>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;" t-esc="line['pump']"/>
                                    <td style="border:1px solid #000; padding:2px;" t-esc="line['cashier']"/>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;" t-esc="line['payment']"/>
                                    <td style="border:1px solid #000; padding:2px; text-align:right;">
                                        <t t-esc="'%.3f' % line['qty']"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:right;">
                                        <t t-esc="'%.4f' % line['unit_price']"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:right; font-weight:bold;">
                                        <t t-esc="'%.4f' % line['total']"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr style="font-weight:bold; background:#F2F2F2;">
                                <td colspan="10" style="border:1px solid #000; padding:3px; text-align:center;">Grand Total</td>
                                <td style="border:1px solid #000; padding:2px; text-align:right;">
                                    <t t-esc="'%.4f' % totals['revenue']"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- Summary block -->
                    <div style="margin-top:14px; font-size:9px;">
                        <strong>Summary</strong>
                        <table style="border-collapse:collapse; margin-top:4px; min-width:300px;">
                            <tr>
                                <td style="border:1px solid #ccc; padding:3px 8px; width:180px;">Total Fuel Dispensed (L)</td>
                                <td style="border:1px solid #ccc; padding:3px 8px; text-align:right; min-width:90px;">
                                    <t t-esc="'%.3f' % totals['fuel_litres']"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border:1px solid #ccc; padding:3px 8px;">Total LPG Units</td>
                                <td style="border:1px solid #ccc; padding:3px 8px; text-align:right;">
                                    <t t-esc="'%.0f' % totals['lpg_units']"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border:1px solid #ccc; padding:3px 8px;">Lubricant Revenue (ZMW)</td>
                                <td style="border:1px solid #ccc; padding:3px 8px; text-align:right;">
                                    <t t-esc="'%.4f' % totals['lubricant_revenue']"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
