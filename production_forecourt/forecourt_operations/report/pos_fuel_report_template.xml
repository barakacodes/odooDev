<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="pos_fuel_report_document">
    <t t-call="web.html_container">
      <t t-call="web.external_layout">
        <div class="page">
          <h2>Daily Fuel Sales Report</h2>
          <p>
            Date: <t t-esc="report_date or ''"/>
            | Branch: <t t-esc="branch_label"/>
            | Shift: <t t-esc="shift_label"/>
            | Section: <t t-esc="section_label or 'All'"/>
          </p>

          <t t-if="not blocks">
            <div>No sessions found for the selected criteria.</div>
          </t>

          <t t-foreach="blocks" t-as="block">
            <h3>
              <t t-esc="block['branch_label']"/> -
              <t t-esc="block['shift_label']"/> -
              Session: <t t-esc="block['session_name']"/>
            </h3>
            <table class="table table-sm table-bordered">
              <thead>
                <tr>
                  <th></th>
                  <th style="text-align:right">Petrol</th>
                  <th style="text-align:right">Diesel</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>Opening Stock (L)</td><td style="text-align:right"><t t-esc="'%.3f' % block['petrol']['opening_stock']"/></td><td style="text-align:right"><t t-esc="'%.3f' % block['diesel']['opening_stock']"/></td></tr>
                <tr><td>Total Litres Sold</td><td style="text-align:right"><t t-esc="'%.3f' % block['petrol']['litres_sold']"/></td><td style="text-align:right"><t t-esc="'%.3f' % block['diesel']['litres_sold']"/></td></tr>
                <tr><td>Cash Sales (L)</td><td style="text-align:right"><t t-esc="'%.3f' % block['petrol']['cash_litres']"/></td><td style="text-align:right"><t t-esc="'%.3f' % block['diesel']['cash_litres']"/></td></tr>
                <tr><td>Card Sales (L)</td><td style="text-align:right"><t t-esc="'%.3f' % block['petrol']['card_litres']"/></td><td style="text-align:right"><t t-esc="'%.3f' % block['diesel']['card_litres']"/></td></tr>
                <tr><td>Total Revenue (ZMW)</td><td style="text-align:right"><t t-esc="'%.2f' % block['petrol']['total_amount']"/></td><td style="text-align:right"><t t-esc="'%.2f' % block['diesel']['total_amount']"/></td></tr>
                <tr><td>Prepaid Litres</td><td style="text-align:right"><t t-esc="'%.3f' % block['petrol']['prepaid_litres']"/></td><td style="text-align:right"><t t-esc="'%.3f' % block['diesel']['prepaid_litres']"/></td></tr>
                <tr><td>Account Litres</td><td style="text-align:right"><t t-esc="'%.3f' % block['petrol']['account_litres']"/></td><td style="text-align:right"><t t-esc="'%.3f' % block['diesel']['account_litres']"/></td></tr>
                <tr><td>Test Fuel (L)</td><td style="text-align:right"><t t-esc="'%.3f' % block['petrol'].get('test_litres', 0)"/></td><td style="text-align:right"><t t-esc="'%.3f' % block['diesel'].get('test_litres', 0)"/></td></tr>
                <tr><td>Received During Shift (L)</td><td style="text-align:right"><t t-esc="'%.3f' % block['petrol']['received']"/></td><td style="text-align:right"><t t-esc="'%.3f' % block['diesel']['received']"/></td></tr>
                <tr><td>Closing Stock (L)</td><td style="text-align:right"><t t-esc="'%.3f' % block['petrol']['closing_stock']"/></td><td style="text-align:right"><t t-esc="'%.3f' % block['diesel']['closing_stock']"/></td></tr>
              </tbody>
            </table>
          </t>
        </div>
      </t>
    </t>
  </template>
</odoo>
