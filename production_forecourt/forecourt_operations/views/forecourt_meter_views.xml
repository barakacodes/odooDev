<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forecourt_meter_list" model="ir.ui.view">
        <field name="name">forecourt.meter.reading.list</field>
        <field name="model">forecourt.meter.reading</field>
        <field name="arch" type="xml">
            <list string="Meter Readings">
                <field name="name"/>
                <field name="reading_datetime"/>
                <field name="pump_id"/>
                <field name="nozzle_id"/>
                <field name="shift_id" optional="show"/>
                <field name="reading_type" widget="badge"
                       decoration-success="reading_type=='opening'"
                       decoration-warning="reading_type=='closing'"/>
                <field name="previous_reading" optional="show"/>
                <field name="meter_value"/>
                <field name="volume" sum="Total Volume (L)"/>
                <field name="recorded_by"/>
            </list>
        </field>
    </record>

    <record id="view_forecourt_meter_form" model="ir.ui.view">
        <field name="name">forecourt.meter.reading.form</field>
        <field name="model">forecourt.meter.reading</field>
        <field name="arch" type="xml">
            <form string="Pump Meter Reading">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Reading Details">
                            <field name="reading_datetime"/>
                            <field name="pump_id"/>
                            <field name="nozzle_id"
                                   domain="[('pump_id','=',pump_id)]"/>
                            <field name="reading_type"/>
                            <field name="shift_id"/>
                        </group>
                        <group string="Values">
                            <field name="previous_reading"/>
                            <field name="meter_value"/>
                            <field name="volume" readonly="1"/>
                            <field name="recorded_by"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_forecourt_meter_search" model="ir.ui.view">
        <field name="name">forecourt.meter.reading.search</field>
        <field name="model">forecourt.meter.reading</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="pump_id"/>
                <field name="recorded_by"/>
                <filter name="opening" string="Opening"
                        domain="[('reading_type','=','opening')]"/>
                <filter name="closing" string="Closing"
                        domain="[('reading_type','=','closing')]"/>
                <filter name="today" string="Today"
                        domain="[('reading_datetime','&gt;=',datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_pump" string="Pump"
                            context="{'group_by': 'pump_id'}"/>
                    <filter name="group_shift" string="Shift"
                            context="{'group_by': 'shift_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'reading_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_forecourt_meter" model="ir.actions.act_window">
        <field name="name">Meter Readings</field>
        <field name="res_model">forecourt.meter.reading</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>