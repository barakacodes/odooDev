<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_forecourt_inherit" model="ir.ui.view">
        <field name="name">stock.warehouse.form.forecourt.inherit</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_forecourt_tanks" type="object"
                        class="oe_stat_button" icon="fa-tint"
                        invisible="not is_forecourt_branch">
                    <field name="forecourt_tank_count" widget="statinfo" string="Tanks"/>
                </button>
            </xpath>
            <xpath expr="//group[field[@name='partner_id']]/.." position="after">
                <group string="Forecourt">
                    <field name="is_forecourt_branch"/>
                </group>
            </xpath>
            <xpath expr="//sheet/notebook[1]" position="after">
                <notebook invisible="not is_forecourt_branch">
                    <page string="Forecourt Tanks" name="forecourt_tanks">
                        <field name="forecourt_tank_ids">
                            <list>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="product_id"/>
                                <field name="capacity"/>
                                <field name="current_level"/>
                                <field name="reorder_level"/>
                                <field name="active" column_invisible="True"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="action_forecourt_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">stock.warehouse</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_forecourt_branch', '=', True)]</field>
        <field name="context">{'default_is_forecourt_branch': True}</field>
    </record>
</odoo>
