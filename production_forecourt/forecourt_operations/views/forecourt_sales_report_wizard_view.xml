<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forecourt_sales_report_wizard_form" model="ir.ui.view">
        <field name="name">forecourt.sales.report.wizard.form</field>
        <field name="model">forecourt.sales.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Forecourt Sales Report">
                <group><group string="Report Parameters">
                    <field name="company_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="product_type"/>
                    <field name="payment_method"/>
                </group></group>
                <footer>
                    <button name="action_print_pdf" string="View PDF"
                            type="object" class="btn-primary"/>
                    <button name="action_export_excel" string="Export XLSX"
                            type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_forecourt_sales_report_wizard" model="ir.actions.act_window">
        <field name="name">Forecourt Sales Report</field>
        <field name="res_model">forecourt.sales.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
