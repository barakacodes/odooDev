<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forecourt_reconciliation_wizard_form" model="ir.ui.view">
        <field name="name">forecourt.reconciliation.wizard.form</field>
        <field name="model">forecourt.reconciliation.wizard</field>
        <field name="arch" type="xml">
            <form string="Tank Reconciliation Report">
                <group><group string="Report Parameters">
                    <field name="company_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="tank_ids" widget="many2many_tags"
                           placeholder="Leave empty for all tanks"/>
                </group></group>
                <footer>
                    <button name="action_print_pdf" string="View PDF"
                            type="object" class="btn-primary"/>
                    <button name="action_export_excel" string="Export XLSX"
                            type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_forecourt_reconciliation_wizard" model="ir.actions.act_window">
        <field name="name">Tank Reconciliation</field>
        <field name="res_model">forecourt.reconciliation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
