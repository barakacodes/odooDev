<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forecourt_sale_list" model="ir.ui.view">
        <field name="name">forecourt.sale.list</field>
        <field name="model">forecourt.sale</field>
        <field name="arch" type="xml">
            <list string="Sales Transactions"
                  decoration-muted="state=='cancelled'"
                  decoration-warning="state=='draft'">
                <field name="name"/>
                <field name="sale_datetime"/>
                <field name="shift_id"/>
                <field name="product_type"/>
                <field name="product_id"/>
                <field name="pump_id" optional="show"/>
                <field name="nozzle_id" optional="hide"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="total_amount" sum="Total Revenue"/>
                <field name="payment_method"/>
                <field name="cashier_id"/>
                <field name="customer_id" optional="hide"/>
                <field name="customer_type" optional="hide"/>
                <field name="is_test" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state=='posted'"
                       decoration-warning="state=='draft'"
                       decoration-danger="state=='cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_forecourt_sale_form" model="ir.ui.view">
        <field name="name">forecourt.sale.form</field>
        <field name="model">forecourt.sale</field>
        <field name="arch" type="xml">
            <form string="Forecourt Sale">
                <header>
                    <button name="action_post" string="Post Sale"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Post this sale? Tank/stock levels will be updated."/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state == 'cancelled'"
                            groups="forecourt_operations.group_forecourt_supervisor"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"
                            groups="forecourt_operations.group_forecourt_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Transaction Details">
                            <field name="sale_datetime"
                                   readonly="state != 'draft'"/>
                            <field name="shift_id"
                                   readonly="state != 'draft'"/>
                            <field name="cashier_id"
                                   readonly="state != 'draft'"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Product">
                            <field name="product_type"
                                   readonly="state != 'draft'"/>
                            <field name="product_id"
                                   readonly="state != 'draft'"/>
                            <field name="pump_id"
                                   readonly="state != 'draft'"
                                   invisible="product_type not in ['fuel']"/>
                            <field name="nozzle_id"
                                   readonly="state != 'draft'"
                                   invisible="product_type not in ['fuel']"
                                   domain="[('pump_id','=',pump_id)]"/>
                        </group>
                    </group>
                    <group>
                        <group string="Pricing">
                            <field name="quantity"
                                   readonly="state != 'draft'"/>
                            <field name="unit_label" readonly="1"/>
                            <field name="unit_price"
                                   readonly="state != 'draft'"/>
                            <field name="total_amount" readonly="1"/>
                        </group>
                        <group string="Payment">
                            <field name="payment_method"
                                   readonly="state != 'draft'"/>
                            <field name="customer_id"
                                   readonly="state != 'draft'"/>
                            <field name="customer_type"
                                   readonly="state != 'draft'"/>
                            <field name="is_test"
                                   readonly="state != 'draft'"/>
                            <field name="notes"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_forecourt_sale_search" model="ir.ui.view">
        <field name="name">forecourt.sale.search</field>
        <field name="model">forecourt.sale</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="cashier_id"/>
                <field name="shift_id"/>
                <field name="customer_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="posted" string="Posted" domain="[('state','=','posted')]"/>
                <filter name="today" string="Today"
                        domain="[('sale_datetime','&gt;=',datetime.datetime.now().strftime('%Y-%m-%d 00:00:00')),
                                  ('sale_datetime','&lt;=',datetime.datetime.now().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter name="prepaid" string="Prepaid Wallet" domain="[('customer_type','=','prepaid')]"/>
                <filter name="account_holder" string="Account Holder" domain="[('customer_type','=','account_holder')]"/>
                <filter name="test" string="Test / Calibration" domain="[('is_test','=',True)]"/>
                <filter name="fuel" string="Fuel" domain="[('product_type','=','fuel')]"/>
                <filter name="lpg" string="LPG" domain="[('product_type','=','lpg')]"/>
                <filter name="lubricant" string="Lubricants"
                        domain="[('product_type','=','lubricant')]"/>
                <separator/>
                <filter name="cash" string="Cash"
                        domain="[('payment_method','=','cash')]"/>
                <filter name="mobile_money" string="Mobile Money"
                        domain="[('payment_method','=','mobile_money')]"/>
                <filter name="card" string="Card / POS"
                        domain="[('payment_method','=','card')]"/>
                <filter name="credit" string="Fleet / Credit"
                        domain="[('payment_method','=','credit')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_product_type" string="Product Type"
                            context="{'group_by': 'product_type'}"/>
                    <filter name="group_payment" string="Payment Method"
                            context="{'group_by': 'payment_method'}"/>
                    <filter name="group_shift" string="Shift"
                            context="{'group_by': 'shift_id'}"/>
                    <filter name="group_cashier" string="Cashier"
                            context="{'group_by': 'cashier_id'}"/>
                    <filter name="group_pump" string="Pump"
                            context="{'group_by': 'pump_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'sale_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_forecourt_sale" model="ir.actions.act_window">
        <field name="name">Sales Transactions</field>
        <field name="res_model">forecourt.sale</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_posted': 1}</field>
    </record>

    <record id="action_forecourt_sale_new" model="ir.actions.act_window">
        <field name="name">New Sale</field>
        <field name="res_model">forecourt.sale</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
