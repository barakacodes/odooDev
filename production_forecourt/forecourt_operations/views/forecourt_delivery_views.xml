<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forecourt_delivery_list" model="ir.ui.view">
        <field name="name">forecourt.delivery.list</field>
        <field name="model">forecourt.delivery</field>
        <field name="arch" type="xml">
            <list string="Deliveries"
                  decoration-muted="state=='cancelled'"
                  decoration-warning="state=='draft'">
                <field name="name"/>
                <field name="delivery_date"/>
                <field name="product_type"/>
                <field name="product_id"/>
                <field name="tank_id" optional="show"/>
                <field name="warehouse_id"/>
                <field name="quantity_received"/>
                <field name="supplier_id"/>
                <field name="invoice_number" optional="show"/>
                <field name="waybill_number" optional="hide"/>
                <field name="received_by"/>
                <field name="state" widget="badge"
                       decoration-success="state=='received'"
                       decoration-warning="state=='draft'"
                       decoration-danger="state=='cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_forecourt_delivery_form" model="ir.ui.view">
        <field name="name">forecourt.delivery.form</field>
        <field name="model">forecourt.delivery</field>
        <field name="arch" type="xml">
            <form string="Stock Delivery / Receipt">
                <header>
                    <button name="action_confirm_receipt" string="Confirm Receipt"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Confirm delivery? Tank/stock levels will be updated."/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state == 'cancelled'"
                            groups="forecourt_operations.group_forecourt_supervisor"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,received"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_receipt" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not picking_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Stock Receipt</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Delivery Details">
                            <field name="delivery_date"
                                   readonly="state != 'draft'"/>
                            <field name="product_type"
                                   readonly="state != 'draft'"/>
                            <field name="product_id"
                                   readonly="state != 'draft'"/>
                            <field name="warehouse_id"
                                   readonly="state != 'draft'"/>
                            <field name="tank_id"
                                   readonly="state != 'draft'"
                                   invisible="product_type != 'fuel' or tank_allocation_ids"
                                   required="product_type == 'fuel' and not tank_allocation_ids"/>
                            <field name="quantity_received"
                                   readonly="state != 'draft'"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Supplier &amp; Costing">
                            <field name="supplier_id"
                                   readonly="state != 'draft'"/>
                            <field name="invoice_number"
                                   readonly="state != 'draft'"/>
                            <field name="waybill_number"
                                   readonly="state != 'draft'"/>
                            <field name="unit_cost"
                                   readonly="state != 'draft'"/>
                            <field name="total_cost" readonly="1"/>
                            <field name="received_by"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tanks" name="tanks"
                              invisible="product_type != 'fuel'">
                            <div class="alert alert-info" role="alert"
                                 invisible="tank_id and not tank_allocation_ids">
                                Optional: split this delivery's quantity across multiple
                                tanks. Leave empty to receive the full quantity into the
                                single Tank selected above. If used, the amounts below must
                                add up to the Quantity Received.
                            </div>
                            <field name="tank_allocation_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="tank_id"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes_page">
                            <field name="notes" placeholder="Notes…"
                                   readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_forecourt_delivery_search" model="ir.ui.view">
        <field name="name">forecourt.delivery.search</field>
        <field name="model">forecourt.delivery</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="invoice_number"/>
                <filter name="draft" string="Pending"
                        domain="[('state','=','draft')]"/>
                <filter name="received" string="Received"
                        domain="[('state','=','received')]"/>
                <filter name="fuel" string="Fuel"
                        domain="[('product_type','=','fuel')]"/>
                <filter name="lpg" string="LPG"
                        domain="[('product_type','=','lpg')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_product_type" string="Product Type"
                            context="{'group_by': 'product_type'}"/>
                    <filter name="group_supplier" string="Supplier"
                            context="{'group_by': 'supplier_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'delivery_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_forecourt_delivery" model="ir.actions.act_window">
        <field name="name">Deliveries &amp; Receipts</field>
        <field name="res_model">forecourt.delivery</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
