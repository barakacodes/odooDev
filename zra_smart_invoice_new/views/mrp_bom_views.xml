<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Item Composition sync (checklist #9) on the BOM form -->
    <record id="view_mrp_bom_form_zra" model="ir.ui.view">
        <field name="name">mrp.bom.form.zra</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_send_composition_to_zra" type="object"
                        class="oe_stat_button" icon="fa-cubes"
                        invisible="not bom_line_ids">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text" invisible="not zra_composition_synced">Composition</span>
                        <span class="o_stat_text" invisible="zra_composition_synced">Send Composition</span>
                        <span class="o_stat_text">to ZRA</span>
                    </div>
                </button>
            </div>
            <field name="product_tmpl_id" position="after">
                <field name="zra_composition_synced" readonly="1"/>
            </field>
        </field>
    </record>

</odoo>
