<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zra_classification_code_list" model="ir.ui.view">
        <field name="name">zra.classification.code.list</field>
        <field name="model">zra.classification.code</field>
        <field name="arch" type="xml">
            <list string="ZRA Classification Codes">
                <field name="item_cls_cd"/>
                <field name="item_cls_nm"/>
                <field name="item_cls_lvl"/>
                <field name="tax_ty_cd" optional="hide"/>
                <field name="use_yn" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_zra_classification_code_search" model="ir.ui.view">
        <field name="name">zra.classification.code.search</field>
        <field name="model">zra.classification.code</field>
        <field name="arch" type="xml">
            <search string="Search Classification Codes">
                <field name="item_cls_cd"/>
                <field name="item_cls_nm"/>
                <filter string="Level 4 (Commodity)" name="level_4" domain="[('item_cls_lvl', '=', 4)]"/>
            </search>
        </field>
    </record>

    <record id="action_zra_classification_code" model="ir.actions.act_window">
        <field name="name">Classification Codes</field>
        <field name="res_model">zra.classification.code</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_level_4': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No classification codes synced yet.
            </p>
            <p>
                Use "Sync Classification Codes" on the ZRA Settings screen to
                pull the UNSPSC code list from Smart Invoice.
            </p>
        </field>
    </record>

    <record id="view_zra_standard_code_list" model="ir.ui.view">
        <field name="name">zra.standard.code.list</field>
        <field name="model">zra.standard.code</field>
        <field name="arch" type="xml">
            <list string="ZRA Standard Codes">
                <field name="cd_cls"/>
                <field name="cd_cls_nm"/>
                <field name="cd"/>
                <field name="cd_nm"/>
            </list>
        </field>
    </record>

    <record id="view_zra_standard_code_search" model="ir.ui.view">
        <field name="name">zra.standard.code.search</field>
        <field name="model">zra.standard.code</field>
        <field name="arch" type="xml">
            <search string="Search Standard Codes">
                <field name="cd_cls_nm"/>
                <field name="cd"/>
                <field name="cd_nm"/>
                <group expand="0" string="Group By">
                    <filter string="Code Class" name="group_cls" context="{'group_by': 'cd_cls_nm'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_zra_standard_code" model="ir.actions.act_window">
        <field name="name">Standard Codes</field>
        <field name="res_model">zra.standard.code</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_cls': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No standard codes synced yet.
            </p>
            <p>
                Use "Sync Standard Codes" on the ZRA Settings screen to pull
                VSDC constants (payment types, packaging units, tax types, etc.)
                from Smart Invoice.
            </p>
        </field>
    </record>

</odoo>
