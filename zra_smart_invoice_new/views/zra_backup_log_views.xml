<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zra_backup_log_list" model="ir.ui.view">
        <field name="name">zra.backup.log.list</field>
        <field name="model">zra.backup.log</field>
        <field name="arch" type="xml">
            <list string="ZRA Backup Runs" create="false" edit="false" delete="false">
                <field name="create_date" string="Run Date"/>
                <field name="name" string="Database"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'failed'"/>
                <field name="file_path"/>
                <field name="file_size" widget="integer"/>
                <field name="duration_seconds"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <record id="action_zra_backup_log" model="ir.actions.act_window">
        <field name="name">Backup Runs</field>
        <field name="res_model">zra.backup.log</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No backup runs yet.
            </p>
            <p>
                The "ZRA: Nightly Database Backup" scheduled action
                (Settings &gt; Technical &gt; Scheduled Actions) creates one
                row here every time it runs — this is the evidence trail
                that internal checklist item #21 is actually running, not
                just implemented as a script someone has to remember to
                schedule.
            </p>
        </field>
    </record>

</odoo>
