<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Declaration form view ───────────────────────────────────────────── -->
    <record id="view_zra_import_declaration_form" model="ir.ui.view">
        <field name="name">zra.import.declaration.form</field>
        <field name="model">zra.import.declaration</field>
        <field name="arch" type="xml">
            <form string="ZRA Import Declaration">
                <header>
                    <button name="action_fetch_from_zra" type="object"
                            string="Fetch from ZRA" class="oe_highlight"
                            invisible="state == 'received'"/>
                    <button name="action_create_stock_receipt" type="object"
                            string="Create Stock Receipt" class="btn-primary"
                            invisible="state not in ['fetched', 'linked']"/>
                    <button name="action_update_zra_items" type="object"
                            string="Update Items on ZRA" class="btn-primary"
                            invisible="state not in ['linked', 'received'] or not has_pending_zra_updates"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,fetched,linked,received"/>
                    <field name="has_pending_zra_updates" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Declaration No."/></h1>
                    </div>

                    <group>
                        <group string="Declaration Details">
                            <field name="company_id"/>
                            <field name="declaration_date"/>
                            <field name="task_cd" readonly="1"/>
                            <field name="declarant_name" readonly="1"/>
                            <field name="declarant_tpin" readonly="1"/>
                            <field name="hscode" readonly="1"/>
                            <field name="last_fetch_date" readonly="1"/>
                        </group>
                        <group string="Origin &amp; Destination">
                            <field name="origin_country_id" readonly="1"
                                   options="{'no_create': True}"/>
                            <field name="export_country_id" readonly="1"
                                   options="{'no_create': True}"/>
                            <field name="foreign_currency_id" readonly="1"/>
                            <field name="exchange_rate" readonly="1"/>
                        </group>
                    </group>

                    <group string="Financial Summary">
                        <group>
                            <field name="invoice_foreign_currency_amount" readonly="1"/>
                            <field name="invoice_zmw_amount" readonly="1"/>
                            <field name="customs_value" readonly="1"/>
                        </group>
                        <group>
                            <field name="gross_mass" readonly="1"/>
                            <field name="net_mass" readonly="1"/>
                            <field name="duty_amount" readonly="1"/>
                            <field name="vat_amount" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Declaration Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="item_seq" readonly="1"/>
                                    <field name="item_cd" readonly="1"/>
                                    <field name="item_cls_cd" readonly="1"/>
                                    <field name="item_name" readonly="1"/>
                                    <field name="qty" readonly="1"/>
                                    <field name="qty_unit_cd" readonly="1"/>
                                    <field name="unit_price" readonly="1"/>
                                    <field name="supply_amount" readonly="1"/>
                                    <field name="duty_rate" readonly="1"/>
                                    <field name="duty_amount" readonly="1"/>
                                    <field name="total_amount" readonly="1"/>
                                    <!-- editable: link to Odoo product -->
                                    <field name="product_id"
                                           options="{'no_create': True}"
                                           domain="[]"/>
                                    <field name="zra_updated" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Raw ZRA Response" name="raw">
                            <field name="raw_response" readonly="1"
                                   widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Declaration list view ────────────────────────────────────────────── -->
    <record id="view_zra_import_declaration_list" model="ir.ui.view">
        <field name="name">zra.import.declaration.list</field>
        <field name="model">zra.import.declaration</field>
        <field name="arch" type="xml">
            <list string="ZRA Import Declarations" decoration-muted="state == 'received'">
                <field name="name"/>
                <field name="declaration_date"/>
                <field name="declarant_name"/>
                <field name="origin_country_id"/>
                <field name="customs_value"/>
                <field name="duty_amount"/>
                <field name="vat_amount"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'fetched'"
                       decoration-primary="state == 'linked'"
                       decoration-success="state == 'received'"/>
            </list>
        </field>
    </record>

    <!-- ── Search view ──────────────────────────────────────────────────────── -->
    <record id="view_zra_import_declaration_search" model="ir.ui.view">
        <field name="name">zra.import.declaration.search</field>
        <field name="model">zra.import.declaration</field>
        <field name="arch" type="xml">
            <search string="Search Import Declarations">
                <field name="name" string="Declaration No."/>
                <field name="declarant_name"/>
                <field name="origin_country_id"/>
                <separator/>
                <filter string="Draft"    name="draft"    domain="[('state','=','draft')]"/>
                <filter string="Fetched"  name="fetched"  domain="[('state','=','fetched')]"/>
                <filter string="Linked"   name="linked"   domain="[('state','=','linked')]"/>
                <filter string="Received" name="received" domain="[('state','=','received')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Origin Country" name="group_origin"
                            context="{'group_by': 'origin_country_id'}"/>
                    <filter string="Date" name="group_date"
                            context="{'group_by': 'declaration_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Window action ────────────────────────────────────────────────────── -->
    <record id="action_zra_import_declaration" model="ir.actions.act_window">
        <field name="name">Import Declarations</field>
        <field name="res_model">zra.import.declaration</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zra_import_declaration_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No import declarations yet
            </p>
            <p>
                Use the <strong>Fetch Declarations</strong> button to pull import
                declarations from the ZRA VSDC API, then link each line to an
                Odoo product and create a stock receipt.
            </p>
        </field>
    </record>

    <!-- ── Fetch wizard form ────────────────────────────────────────────────── -->
    <record id="view_zra_import_declaration_fetch_form" model="ir.ui.view">
        <field name="name">zra.import.declaration.fetch.form</field>
        <field name="model">zra.import.declaration.fetch</field>
        <field name="arch" type="xml">
            <form string="Fetch Import Declarations from ZRA">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Pulls all import declarations registered with ZRA between
                        the selected dates and creates them locally for review.
                    </div>
                    <group>
                        <field name="company_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_fetch" type="object"
                            string="Fetch from ZRA" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Fetch wizard action ──────────────────────────────────────────────── -->
    <record id="action_zra_import_declaration_fetch" model="ir.actions.act_window">
        <field name="name">Fetch Import Declarations</field>
        <field name="res_model">zra.import.declaration.fetch</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
