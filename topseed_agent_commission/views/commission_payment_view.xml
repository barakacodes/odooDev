<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_payment_form" model="ir.ui.view">
        <field name="name">topseed.commission.payment.form</field>
        <field name="model">topseed.commission.payment</field>
        <field name="arch" type="xml">
            <form string="Commission Payment">
                <sheet>
                    <header>
                        <button name="action_approve" string="Approve" type="object" 
                                class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="action_confirm_paid" string="Confirm Paid" type="object" 
                                class="btn-success" attrs="{'invisible': [('state', '!=', 'approved')]}"/>
                        <button name="action_cancel" string="Cancel" type="object" 
                                class="btn-danger" attrs="{'invisible': [('state', 'in', ['paid', 'cancelled'])]}"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,approved,paid"/>
                    </header>
                    <group>
                        <group>
                            <field name="payment_number"/>
                            <field name="agent_id"/>
                            <field name="payment_date"/>
                            <field name="payment_amount"/>
                        </group>
                        <group>
                            <field name="payment_method"/>
                            <field name="reference"/>
                            <field name="bank_account"/>
                            <field name="bank_name"/>
                        </group>
                    </group>
                    <group>
                        <field name="commission_line_ids" widget="many2many_tags"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_commission_payment_tree" model="ir.ui.view">
        <field name="name">topseed.commission.payment.tree</field>
        <field name="model">topseed.commission.payment</field>
        <field name="arch" type="xml">
            <tree string="Commission Payments">
                <field name="payment_number"/>
                <field name="agent_id"/>
                <field name="payment_date"/>
                <field name="payment_amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    
    <record id="action_commission_payment" model="ir.actions.act_window">
        <field name="name">Commission Payments</field>
        <field name="res_model">topseed.commission.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="help">Manage commission payments to agents.</field>
    </record>
</odoo>
